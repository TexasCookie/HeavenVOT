{
  "manifest_version": 3,
  "name": "Local Video Translate",
  "version": "0.3.7",
  "description": "Local закадр for YouTube watch VOD.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "scripting", "cookies", "webRequest"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.googlevideo.com/*",
    "https://*.google.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "extension/background.js"
  },
  "action": {
    "default_title": "Local Video Translate",
    "default_popup": "extension/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["extension/session-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["extension/policy.js", "extension/mixer.js", "extension/player-button.js", "extension/captions.js", "extension/asr-audio.js", "extension/content.js"],
      "css": ["extension/player-button.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["extension/injected.js", "extension/asr-audio.js", "extension/session-hook.js", "injected.js"],
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"]
    }
  ]
}
